<?xml version="1.0" encoding="utf-8"?>
<!--
  Single source: nuget.org. The plan's "float DotnetOpenEhr to latest"
  posture relies on no lock file being present; do not introduce a
  packages.lock.json or run dotnet restore with the locked-mode flag
  here, or the floating range silently becomes pinned to first restore.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
