<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotnetFhirConnect.Cli</RootNamespace>
    <AssemblyName>DotnetFhirConnect.Cli</AssemblyName>
    <PackageId>DotnetFhirConnect.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fhirconnect</ToolCommandName>
    <Description>
      Command-line wrapper for DotnetFhirConnect. Provides
      'transform' and 'validate' verbs over FHIRconnect mapping
      bundles.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetFhirConnect\DotnetFhirConnect.csproj" />
  </ItemGroup>

</Project>
