<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotnetFhirConnect.FhirR4B</RootNamespace>
    <AssemblyName>DotnetFhirConnect.FhirR4B</AssemblyName>
    <PackageId>DotnetFhirConnect.FhirR4B</PackageId>
    <Description>
      HL7 FHIR R4B binding for DotnetFhirConnect. References
      DotnetFhirConnect.Core plus Hl7.Fhir.R4B, providing the R4B
      adapter and the typed R4BEngine facade. Reference this single
      package for idiomatic, alias-free R4B transformations.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetFhirConnect.Core\DotnetFhirConnect.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.R4B" />
  </ItemGroup>

</Project>
