<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotnetFhirConnect.FhirR5</RootNamespace>
    <AssemblyName>DotnetFhirConnect.FhirR5</AssemblyName>
    <PackageId>DotnetFhirConnect.FhirR5</PackageId>
    <Description>
      HL7 FHIR R5 binding for DotnetFhirConnect. References
      DotnetFhirConnect.Core plus Hl7.Fhir.R5, providing the R5
      adapter and the typed R5Engine facade. Reference this single
      package for idiomatic, alias-free R5 transformations.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetFhirConnect.Core\DotnetFhirConnect.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hl7.Fhir.R5" />
  </ItemGroup>

</Project>
