<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotnetFhirConnect</RootNamespace>
    <AssemblyName>DotnetFhirConnect</AssemblyName>
    <PackageId>DotnetFhirConnect</PackageId>
    <Description>
      .NET implementation of the FHIRconnect mapping language for
      bidirectional transformation between openEHR Compositions and
      HL7 FHIR Resources. Walking-skeleton release.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotnetOpenEhr" />
    <PackageReference Include="Hl7.Fhir.R4" />
    <PackageReference Include="Hl7.Fhir.R4B" />
    <PackageReference Include="Hl7.Fhir.R5" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

</Project>
