<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotnetFhirConnect</RootNamespace>
    <AssemblyName>DotnetFhirConnect</AssemblyName>
    <PackageId>DotnetFhirConnect</PackageId>
    <Description>
      .NET implementation of the FHIRconnect mapping language for
      bidirectional transformation between openEHR Compositions and
      HL7 FHIR Resources. Walking-skeleton release.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotnetOpenEhr" />
    <PackageReference Include="Hl7.Fhir.R4" />
    <PackageReference Include="Hl7.Fhir.R4B" />
    <PackageReference Include="Hl7.Fhir.R5" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!--
    Per-release Firely Model assemblies (Hl7.Fhir.R4 / R4B / R5)
    redefine the same Hl7.Fhir.Model.* types in three places, so we
    need extern aliases to disambiguate. The shared layers
    (Hl7.Fhir.Base, Hl7.Fhir.Conformance) stay un-aliased.

    The conventional `Aliases` metadata on `PackageReference` does
    not propagate to transitive package assemblies — verified
    pre-flight in 0603-10. Instead, hook the post-resolution
    `ResolveAssemblyReferences` step and stamp Aliases on the
    matching `ReferencePath` items.
  -->
  <Target Name="AddPackageAliases"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)'=='Hl7.Fhir.R4'">
        <Aliases>coreR4</Aliases>
      </ReferencePath>
      <ReferencePath Condition="'%(FileName)'=='Hl7.Fhir.R4B'">
        <Aliases>coreR4B</Aliases>
      </ReferencePath>
      <ReferencePath Condition="'%(FileName)'=='Hl7.Fhir.R5'">
        <Aliases>coreR5</Aliases>
      </ReferencePath>
      <ReferencePathWithRefAssemblies Condition="'%(FileName)'=='Hl7.Fhir.R4'">
        <Aliases>coreR4</Aliases>
      </ReferencePathWithRefAssemblies>
      <ReferencePathWithRefAssemblies Condition="'%(FileName)'=='Hl7.Fhir.R4B'">
        <Aliases>coreR4B</Aliases>
      </ReferencePathWithRefAssemblies>
      <ReferencePathWithRefAssemblies Condition="'%(FileName)'=='Hl7.Fhir.R5'">
        <Aliases>coreR5</Aliases>
      </ReferencePathWithRefAssemblies>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="DotnetFhirConnect.Tests" />
  </ItemGroup>

  <!--
    Embed the patched FHIRconnect v1.0.0 JSON schemas as resources so
    the validator does not depend on the test fixtures folder at
    runtime. Copied at build time from tests/fixtures/spec-schemas/.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\model-mapping.schema.json">
      <LogicalName>DotnetFhirConnect.Resources.model-mapping.schema.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\contextual-mapping.schema.json">
      <LogicalName>DotnetFhirConnect.Resources.contextual-mapping.schema.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
