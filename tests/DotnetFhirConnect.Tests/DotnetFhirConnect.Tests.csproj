<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DotnetFhirConnect.Tests</RootNamespace>
    <AssemblyName>DotnetFhirConnect.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotnetFhirConnect\DotnetFhirConnect.csproj" />
  </ItemGroup>

  <!--
    Mirror the alias scheme from the main library so test files can
    distinguish between R4 / R4B / R5 Observation POCOs.
  -->
  <Target Name="AddPackageAliases"
          AfterTargets="ResolveAssemblyReferences"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <ReferencePath Condition="'%(FileName)'=='Hl7.Fhir.R4'">
        <Aliases>coreR4</Aliases>
      </ReferencePath>
      <ReferencePath Condition="'%(FileName)'=='Hl7.Fhir.R4B'">
        <Aliases>coreR4B</Aliases>
      </ReferencePath>
      <ReferencePath Condition="'%(FileName)'=='Hl7.Fhir.R5'">
        <Aliases>coreR5</Aliases>
      </ReferencePath>
      <ReferencePathWithRefAssemblies Condition="'%(FileName)'=='Hl7.Fhir.R4'">
        <Aliases>coreR4</Aliases>
      </ReferencePathWithRefAssemblies>
      <ReferencePathWithRefAssemblies Condition="'%(FileName)'=='Hl7.Fhir.R4B'">
        <Aliases>coreR4B</Aliases>
      </ReferencePathWithRefAssemblies>
      <ReferencePathWithRefAssemblies Condition="'%(FileName)'=='Hl7.Fhir.R5'">
        <Aliases>coreR5</Aliases>
      </ReferencePathWithRefAssemblies>
    </ItemGroup>
  </Target>

</Project>
